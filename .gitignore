# Data and models are never committed
/data/**
!/data/**/
!/data/**/.gitkeep
/models/**
!/models/.gitkeep
/reports/figures/*
!/reports/figures/.gitkeep
# Keep metrics.json / predictions.csv / summary.csv, not the raw torch dumps
/reports/results/**/predictions.pt
/reports/logs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
